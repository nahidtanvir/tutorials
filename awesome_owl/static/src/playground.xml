<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="p-3">
            <Card title="'My Title'">
                <Counter onChange="() => this.incrementSum()" />
            </Card>
            <Card title="'My Title 2'">
                <Counter onChange="() => this.incrementSum()" />
            </Card>
            <div class="mt-3">
                <strong>Sum of counters: </strong><span t-esc="state.sum"/>
            </div>
        </div>
        <div class="p-3">
            <TodoList />
        </div>
    </t>

</templates>