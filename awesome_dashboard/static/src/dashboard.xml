<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomerView">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
            </t>
            <div class="d-flex flex-wrap">
                <!-- Loading state -->
                <t t-if="statistics.loading">
                    <DashboardItem size="2">
                        <div class="text-center py-4">
                            <i class="fa fa-spinner fa-spin"/> Loading statistics...
                        </div>
                    </DashboardItem>
                </t>

                <!-- Data loaded state -->
                <t t-if="!statistics.loading and statistics.data">
                    <!-- New Orders Card -->
                    <DashboardItem size="1">
                        <h5 class="card-title">New Orders</h5>
                        <p class="card-text display-4">
                            <t t-esc="statistics.data.nb_new_orders"/>
                        </p>
                    </DashboardItem>

                    <!-- Total Amount Card -->
                    <DashboardItem size="1">
                        <h5 class="card-title">Total Amount</h5>
                        <p class="card-text display-4">
                            <t t-esc="statistics.data.total_amount"/>
                        </p>
                    </DashboardItem>

                    <!-- Average Quantity Card -->
                    <DashboardItem size="1">
                        <h5 class="card-title">Avg Items per Order</h5>
                        <p class="card-text display-4">
                            <t t-esc="statistics.data.average_quantity"/>
                        </p>
                    </DashboardItem>

                    <!-- Cancelled Orders Card -->
                    <DashboardItem size="1">
                        <h5 class="card-title">Cancelled Orders</h5>
                        <p class="card-text display-4">
                            <t t-esc="statistics.data.nb_cancelled_orders"/>
                        </p>
                    </DashboardItem>

                    <!-- Average Processing Time Card -->
                    <DashboardItem size="1">
                        <h5 class="card-title">Avg Processing Time</h5>
                        <p class="card-text display-4">
                            <t t-esc="statistics.data.average_time"/> hours
                        </p>
                    </DashboardItem>

                    <!-- Orders by Size Card -->
                    <DashboardItem size="2">
                        <h5 class="card-title">Orders by Size</h5>
                        <div class="d-flex justify-content-around">
                            <div class="text-center">
                                <div class="h4">S</div>
                                <div><t t-esc="statistics.data.orders_by_size.s"/></div>
                            </div>
                            <div class="text-center">
                                <div class="h4">M</div>
                                <div><t t-esc="statistics.data.orders_by_size.m"/></div>
                            </div>
                            <div class="text-center">
                                <div class="h4">XL</div>
                                <div><t t-esc="statistics.data.orders_by_size.xl"/></div>
                            </div>
                        </div>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

</templates>